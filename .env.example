# Frontend environment variables (Vite)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend environment variables
# Brave Search API Key for Live Web Research and Employer Evidence Corroboration
# Documentation & sign-up: https://api-dashboard.search.brave.com/
# Endpoint used: https://api.search.brave.com/res/v1/web/search
# IMPORTANT SECURITY NOTICE:
# - Set this ONLY in backend environment (e.g. .env locally, Render Environment Secrets).
# - NEVER prefix with VITE_ or expose in React frontend, bundle outputs, or source control.
# - If left empty or unset, backend gracefully reports 'not_configured' without failing.
BRAVE_SEARCH_API_KEY=
