# Public frontend configuration; statically embedded by Vite at build time.
# Use a reviewed HTTPS backend URL for any future hosted build.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend environment variables
# Trusted existing artifact only; no training is needed to serve it.
MODEL_PATH=models/baseline_model.joblib
# Keep false for the controlled demo. Public opt-in is NOT cleared.
SCAMSHIELD_ENABLE_URL_FETCH=false
# Live Web Research and Employer Evidence Corroboration
# Optional providers. No live credentials are required for local text analysis.
# The controlled-demo launcher ignores .env and clears these variables.
#
# 1. Tavily Search API (https://tavily.com):
# Set TAVILY_API_KEY in your local .env or Render Environment Variables
TAVILY_API_KEY=
#
# 2. Brave Search API (https://api-dashboard.search.brave.com/):
BRAVE_SEARCH_API_KEY=
#
# IMPORTANT SECURITY NOTICE:
# - Set keys ONLY in backend environment (e.g. .env locally, Render Environment Secrets).
# - NEVER prefix with VITE_ or expose in React frontend, bundle outputs, or source control.
# - If left empty or unset, backend gracefully reports 'not_configured' without failing.
# - Normal backend startup may read root .env; never commit real values.
# - Rotate previously exposed keys through their owner; this example cannot do so.
