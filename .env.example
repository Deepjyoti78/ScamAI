# Frontend environment variables (Vite)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend environment variables
# Live Web Research and Employer Evidence Corroboration
# You can configure Tavily Search API (recommended) or Brave Search API.
#
# 1. Tavily Search API (https://tavily.com):
# Set TAVILY_API_KEY in your local .env or Render Environment Variables
TAVILY_API_KEY=
#
# 2. Brave Search API (https://api-dashboard.search.brave.com/):
BRAVE_SEARCH_API_KEY=
#
# IMPORTANT SECURITY NOTICE:
# - Set keys ONLY in backend environment (e.g. .env locally, Render Environment Secrets).
# - NEVER prefix with VITE_ or expose in React frontend, bundle outputs, or source control.
# - If left empty or unset, backend gracefully reports 'not_configured' without failing.
